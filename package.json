{
	"name": "@sedlak.r/mq",
	"version": "1.5.0",
	"description": "Message queue for events",
	"source": "src/index.js",
	"main": "./dist/mq.min.js",
	"exports": {
		".": "./dist/mq.min.js",
		"./*": "./dist/*.js"
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"scripts": {
		"dev": "vite",
		"build": "vite build && vite build --mode min",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"bench": "vitest bench --run",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepublishOnly": "npm run lint && npm test && npm run build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sedlakr/EventEmitter.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"author": "Stanislav Hacker",
	"contributors": [
		{
			"name": "Radek Sedlák <sedlak.r@gmail.com>"
		},
		{
			"name": "Stanislav Hacker"
		}
	],
	"license": "ISC",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.8.0",
		"globals": "^17.9.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"vite": "^8.2.0",
		"vitest": "^4.1.10"
	}
}
